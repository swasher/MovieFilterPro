# .dockerignore

# Игнорируем .git
.git

# Игнорируем виртуальные окружения
env/
venv/
.venv/
pyvenv.cfg

# Игнорируем логи
*.log
logs/

# Игнорируем временные файлы
*.tmp
*.temp
.DS_Store
Thumbs.db

# Игнорируем тестовые данные и ненужные директории
node_modules/
*.egg-info/
**/__pycache__
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Игнорируем IDE файлы
.idea/
.vscode/
*.swp
*.swo

# Игнорируем файлы с приватными данными
.env
.env.local
.env.*.local

# Игнорируем локальные данные (если есть)
data/

# Игнорируем фронт, так как он все равно копируется отдельной командой
front/node_modules
front/build
front/.svelte-kit
.vite
npm-debug.log*
pnpm-debug.log*
