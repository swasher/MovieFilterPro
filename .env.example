ALLOWED_HOSTS=localhost,127.0.0.1,192.168.5.127,.life,.ngrok-free.app,qnap
DEBUG=False
ENABLE_BROWSER_RELOAD=False
ENABLE_DEBUG_TOOLBAR=False
SECRET_KEY=<secret key>
HUEY_SQLITE_PATH=/app/data/huey.sqlite3
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<pass>
POSTGRES_DB=<dbname>
# Только для sync_db_from_qnap.sh (прод-база на QNAP, SSH — по ключу).
# Имя контейнера и ssh-хост заданы константами в скрипте.
QNAP_POSTGRES_USER=<user>
QNAP_POSTGRES_PASSWORD=<pass>
QNAP_POSTGRES_DB=<dbname>
# ВАЖНО: API-ключи и URL-ы сервисов (TMDB, OMDB, Tavily, SearXNG, ...) настраиваются
# ТОЛЬКО через UI Preferences (см. AGENTS.md). Для них .env-строк здесь нет и добавлять не надо.
# На dev-машине живые ключи могут добавляться в локальный .env только для отладки/скриптов;
# на проде их в .env нет.

